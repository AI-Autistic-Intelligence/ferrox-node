{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@ferrox-node/aws": [
        "./packages/aws/src/index.ts"
      ],
      "@ferrox-node/aws/*": [
        "./packages/aws/src/*"
      ],
      "@ferrox-node/bitbucket": [
        "./packages/bitbucket/src/index.ts"
      ],
      "@ferrox-node/bitbucket/*": [
        "./packages/bitbucket/src/*"
      ],
      "@ferrox-node/core": [
        "./packages/core/src/index.ts"
      ],
      "@ferrox-node/core/*": [
        "./packages/core/src/*"
      ],
      "@ferrox-node/cqrs": [
        "./packages/cqrs/src/index.ts"
      ],
      "@ferrox-node/cqrs/*": [
        "./packages/cqrs/src/*"
      ],
      "@ferrox-node/database": [
        "./packages/database/src/index.ts"
      ],
      "@ferrox-node/database/*": [
        "./packages/database/src/*"
      ],
      "@ferrox-node/firebase": [
        "./packages/firebase/src/index.ts"
      ],
      "@ferrox-node/firebase/*": [
        "./packages/firebase/src/*"
      ],
      "@ferrox-node/gcp": [
        "./packages/gcp/src/index.ts"
      ],
      "@ferrox-node/gcp/*": [
        "./packages/gcp/src/*"
      ],
      "@ferrox-node/jobs": [
        "./packages/jobs/src/index.ts"
      ],
      "@ferrox-node/jobs/*": [
        "./packages/jobs/src/*"
      ],
      "@ferrox-node/kafka": [
        "./packages/kafka/src/index.ts"
      ],
      "@ferrox-node/kafka/*": [
        "./packages/kafka/src/*"
      ],
      "@ferrox-node/mailer": [
        "./packages/mailer/src/index.ts"
      ],
      "@ferrox-node/mailer/*": [
        "./packages/mailer/src/*"
      ],
      "@ferrox-node/observability": [
        "./packages/observability/src/index.ts"
      ],
      "@ferrox-node/observability/*": [
        "./packages/observability/src/*"
      ],
      "@ferrox-node/redis": [
        "./packages/redis/src/index.ts"
      ],
      "@ferrox-node/redis/*": [
        "./packages/redis/src/*"
      ],
      "@ferrox-node/security": [
        "./packages/security/src/index.ts"
      ],
      "@ferrox-node/security/*": [
        "./packages/security/src/*"
      ],
      "@ferrox-node/stripe": [
        "./packages/stripe/src/index.ts"
      ],
      "@ferrox-node/stripe/*": [
        "./packages/stripe/src/*"
      ],
      "@ferrox-node/transports": [
        "./packages/transports/src/index.ts"
      ],
      "@ferrox-node/transports/*": [
        "./packages/transports/src/*"
      ]
    },
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/__tests__"
  ],
  "ts-node": {
    "experimentalResolver": true
  }
}