{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
  },
  "include": [
    "src/**/*",
    "node-yalc/**/*"
  ],
  "exclude": [
    "src/__tests__",
    "node-yalc/**/__tests__",
    "node-yalc/**/*.spec.ts",
    "node-yalc/**/__mocks__"
  ]
}









